        cursor_layer {
            display-name = "cursor_layer";
            bindings = <
&trans  &trans  &trans  &trans     &trans          &trans                                         &kp HOME    &kp ENTER       &kp UP_ARROW    &kp BACKSPACE    &trans      &trans
&trans  &trans  &trans  &kp LCTRL  &kp LEFT_SHIFT  &trans                                         &kp END     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &shift_f10  &trans
&trans  &trans  &trans  &trans     &trans          &trans  &trans  &trans  &kp DELETE  &kp ENTER  &trans      &trans          &trans          &trans           &trans      &trans
                                                   &trans  &trans  &trans  &trans      &kp SPACE  &shift_f10
            >;

            sensor-bindings =
                <&inc_dec_kp DOWN UP_ARROW>,
                <&inc_dec_kp RIGHT LEFT>;
