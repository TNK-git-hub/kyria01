#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 300   // mousescroll SPEED

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <3000>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <1000>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&mt { flavor = "tap-preferred"; };

&lt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&sk {
    quick-release;
    lazy;
};

/ {
    behaviors {
        Scroll_D_U: Scroll_D_U {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_D_U";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        TD01: TD01 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD01";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp PERIOD>;
        };

        Scroll_U_D: Scroll_U_D {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_U_D";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        Scroll_LR: Scroll_LR {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_LR";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };

        Scroll_RL: Scroll_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_RL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;

            tap-ms = <20>;
        };

        mouse_DU: mouse_DU {
            compatible = "zmk,behavior-sensor-rotate";
            label = "MOUSE_DU";
            #sensor-binding-cells = <0>;
            bindings = <&mmv MOVE_DOWN>, <&mmv MOVE_UP>;
        };

        mouse_RL: mouse_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "MOUSE_RL";
            #sensor-binding-cells = <0>;
            bindings = <&mmv MOVE_RIGHT>, <&mmv MOVE_LEFT>;
        };

        cursorandmouse: cursorandmouse_ {
            compatible = "zmk,behavior-tap-dance";
            label = "CURSORANDMOUSE ";
            #binding-cells = <0>;
            bindings = <&lt 5 SPACE>, <&lt 1 SPACE>;

            tapping-term-ms = <400>;
        };

        new_behavior: new_behavior {
            compatible = "zmk,behavior-key-toggle";
            label = "NEW_BEHAVIOR";
            #binding-cells = <1>;
        };

        mmv_down: mmv_down {
            compatible = "zmk,behavior-input-two-axis";
            label = "MMV_DOWN";
            #binding-cells = <1>;
            y-input-code = <0>;
            x-input-code = <200>;
            time-to-max-speed-ms = <0>;
        };

        shift: shift {
            compatible = "zmk,behavior-hold-tap";
            label = "SHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <800>;
        };

        leftbracket_tapdance: leftbracket_tapdance {
            compatible = "zmk,behavior-tap-dance";
            label = "LEFTBRACKET_TAPDANCE";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET>, <&kp LEFT_BRACE>;
        };

        rightbracker_tapdance: rightbracker_tapdance {
            compatible = "zmk,behavior-tap-dance";
            label = "RIGHTBRACKER_TAPDANCE";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_BRACKET>, <&kp RIGHT_BRACE>;
        };
    };

    combos {
        compatible = "zmk,combos";

        ctrl-shift-combo {
            bindings = <&ctrlShiftCombo>;
            key-positions = <24 25>;
            layers = <0 1 7>;
        };

        one-keyboard-control {
            bindings = <&to 5>;
            key-positions = <12 0>;
        };

        back_comma {
            bindings = <&kp GRAVE>;
            key-positions = <1 2>;
            layers = <1 7>;
        };

        bt_cl_all {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <33 34>;
        };

        bt_next {
            bindings = <&bt BT_NXT>;
            key-positions = <43 33>;
            timeout-ms = <300>;
        };

        number_row_combo {
            bindings = <&tog 1>;
            key-positions = <16 19>;
            layers = <0 1>;
        };

        toggle_mouse {
            bindings = <&tog 2>;
            key-positions = <16 41>;
            layers = <0 2>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <41 15>;
            timeout-ms = <400>;
            layers = <0 1 2>;
        };

        combo_left_shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <15 16>;
            timeout-ms = <200>;
            layers = <0 7 1>;
        };

        combo_right_shift {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <19 20>;
            timeout-ms = <200>;
            layers = <0 7 1>;
        };

        capslook {
            bindings = <&kp CAPSLOCK>;
            key-positions = <15 20>;
            layers = <0>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <21 22>;
            layers = <0 1>;
            timeout-ms = <300>;
        };

        delete_word_combo {
            bindings = <&delete_word>;
            key-positions = <21 22>;
            layers = <3>;
        };

        firstP_gaming {
            bindings = <&tog 10>;
            key-positions = <31 42>;
            layers = <0 1 7 10>;
        };
    };

    macros {
        alt_tab: alt_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "ALT_TAB";
        };

        ctrlShiftCombo: ctrlShiftCombo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LEFT_SHIFT>,
                <&macro_release>,
                <&kp LCTRL &kp LEFT_SHIFT>;

            label = "CTRLSHIFTCOMBO";
        };

        ctrl_a: ctrl_a {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_press>,
                <&kp A>,
                <&macro_release>,
                <&kp RCTRL>;

            label = "CTRL_A";
        };

        delete_word: delete_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp LEFT_ARROW &kp BACKSPACE>,
                <&macro_release>,
                <&kp LCTRL &kp LEFT_SHIFT>;

            label = "DELETE_WORD";
        };

        hi_prv: hi_prv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp LEFT_ARROW>,
                <&macro_release>,
                <&kp LCTRL &kp LEFT_SHIFT>;

            label = "HI_PRV";
        };

        shift_f10: shift_f10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp F10>,
                <&macro_release>,
                <&kp LEFT_SHIFT>;

            label = "SHIFT_F10";
        };

        new_macro: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&key_repeat>;
            label = "NEW_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
&kp GRAVE     &kp Q  &kp W  &kp E  &kp R  &kp T                                                                 &kp Y        &kp U  &kp I      &kp O    &kp P          &kp BSPC
&kp TAB       &kp A  &kp S  &kp D  &kp F  &kp G                                                                 &kp H        &kp J  &kp K      &kp L    &kp SEMICOLON  &kp SQT
&kp LEFT_ALT  &kp Z  &kp X  &kp C  &kp V  &kp B        &alt_tab     &kp LEFT_GUI  &lt 6 BACKSLASH  &lt 7 ENTER  &kp N        &kp M  &kp COMMA  &kp DOT  &kp FSLH       &kp RSHIFT
                                          &lt 3 MINUS  &lt 2 SPACE  &kp LCTRL     &kp RCTRL        &kp SPACE    &lt 9 EQUAL
            >;
        };

        number_row {
            bindings = <
&trans  &kp NUMBER_1     &kp N2  &kp N3    &kp N4      &kp N5                                       &kp N6     &kp N7         &kp N8  &kp N9  &kp N0  &trans
&trans  &trans           &trans  &trans    &trans      &trans                                       &trans     &trans         &trans  &trans  &trans  &trans
&trans  &kp EXCLAMATION  &kp AT  &kp HASH  &kp DOLLAR  &kp PERCENT  &trans  &trans  &trans  &trans  &kp CARET  &kp AMPERSAND  &trans  &trans  &trans  &trans
                                                       &trans       &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };

        mouse_control {
            display-name = "mouse_control";
            bindings = <
&trans  &trans  &trans  &trans     &trans  &trans                                     &trans  &msc SCRL_DOWN  &mmv MOVE_UP         &msc SCRL_UP     &trans     &trans
&trans  &trans  &trans  &kp LCTRL  &trans  &trans                                     &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN       &mmv MOVE_RIGHT  &mkp RCLK  &trans
&trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans     &trans  &msc SCRL_LEFT  &mmv_down MOVE_DOWN  &msc SCRL_RIGHT  &trans     &trans
                                           &trans  &trans  &trans  &trans  &mkp LCLK  &trans
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };

        cursor_layer {
            display-name = "cursor_layer";
            bindings = <
&trans  &trans  &trans     &trans          &trans   &trans                                         &kp HOME    &kp ENTER        &kp UP_ARROW    &kp BACKSPACE    &kp BACKSPACE  &trans
&trans  &trans  &kp LCTRL  &kp LEFT_SHIFT  &kp TAB  &trans                                         &kp END     &kp LEFT_ARROW   &kp DOWN_ARROW  &kp RIGHT_ARROW  &hi_prv        &trans
&trans  &trans  &trans     &trans          &trans   &trans  &trans  &trans  &kp DELETE  &kp ENTER  &trans      &kp RIGHT_SHIFT  &trans          &trans           &trans         &trans
                                                    &trans  &trans  &trans  &trans      &kp SPACE  &shift_f10
            >;

            sensor-bindings =
                <&inc_dec_kp DOWN UP_ARROW>,
                <&inc_dec_kp RIGHT LEFT>;
        };

        onekeyboardControl {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                        &trans  &trans  &trans  &trans          &mmv MOVE_UP    &msc SCRL_RIGHT
&trans  &trans  &trans  &trans  &trans  &trans                                        &trans  &trans  &trans  &msc SCRL_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp RCTRL  &mkp LCLK  &trans  &trans  &trans  &mmv MOVE_LEFT  &msc SCRL_DOWN  &msc SCRL_UP
                                        &trans  &trans  &trans  &trans     &mkp RCLK  &trans
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };

        general_gaming_layer {
            bindings = <
&trans  &kp TAB    &kp Q  &kp W  &kp E  &kp R                                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LSHFT  &kp A  &kp S  &kp D  &kp F                                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &kp Z  &kp X  &kp C  &kp V   &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans  &kp SPACE  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };

        function_layer {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3   &kp F4   &kp F5                                   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F6  &kp F7  &kp F8   &kp F9   &kp F10                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &kp F11  &kp F12  &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                          &trans   &trans  &trans  &trans  &trans  &trans
            >;
        };

        symbol {
            bindings = <
&trans  &kp EXCL   &kp AT         &kp HASH  &kp DOLLAR  &kp PERCENT                                  &trans  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans  &trans
&trans  &kp CARET  &kp AMPERSAND  &kp STAR  &trans      &trans                                       &trans  &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans  &trans
&trans  &trans     &trans         &trans    &trans      &trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans                &trans                 &trans  &trans
                                                        &trans       &trans  &trans  &trans  &trans  &trans
            >;
        };

        window_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        seting_layer {
            bindings = <
&trans  &trans             &trans           &trans         &trans         &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_BRI_DEC  &kp C_BRI_INC  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp C_MUTE         &trans           &trans         &trans         &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                                          &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        gaming1st_person {
            bindings = <
&trans  &kp TAB    &kp Q  &kp W  &kp E  &kp R                                         &trans  &msc SCRL_DOWN  &mmv MOVE_UP    &msc SCRL_UP     &trans     &trans
&trans  &kp LSHFT  &kp A  &kp S  &kp D  &kp F                                         &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp RCLK  &trans
&trans  &trans     &kp Z  &kp X  &kp C  &kp V   &trans     &trans  &trans  &trans     &trans  &trans          &trans          &trans           &trans     &trans
                                        &trans  &kp SPACE  &trans  &trans  &mkp LCLK  &trans
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };
    };
};
