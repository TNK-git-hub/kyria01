#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 300   // mousescroll SPEED

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <3000>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <1000>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&mt { flavor = "tap-preferred"; };

&lt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&sk {
    quick-release;
    lazy;
};

/ {
    behaviors {
        Scroll_D_U: Scroll_D_U {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_D_U";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        TD01: TD01 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD01";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp PERIOD>;
        };

        Scroll_U_D: Scroll_U_D {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_U_D";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        Scroll_LR: Scroll_LR {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_LR";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };

        Scroll_RL: Scroll_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_RL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;

            tap-ms = <20>;
        };

        mouse_DU: mouse_DU {
            compatible = "zmk,behavior-sensor-rotate";
            label = "MOUSE_DU";
            #sensor-binding-cells = <0>;
            bindings = <&mmv MOVE_DOWN>, <&mmv MOVE_UP>;
        };

        mouse_RL: mouse_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "MOUSE_RL";
            #sensor-binding-cells = <0>;
            bindings = <&mmv MOVE_RIGHT>, <&mmv MOVE_LEFT>;
        };

        cursorandmouse: cursorandmouse_ {
            compatible = "zmk,behavior-tap-dance";
            label = "CURSORANDMOUSE ";
            #binding-cells = <0>;
            bindings = <&lt 1 SPACE>, <&lt 2 SPACE>;

            tapping-term-ms = <400>;
        };

        new_behavior: new_behavior {
            compatible = "zmk,behavior-key-toggle";
            label = "NEW_BEHAVIOR";
            #binding-cells = <1>;
        };
    };

    combos {
        compatible = "zmk,combos";

        mouse_control_combo {
            bindings = <&lt 2 SPACE>;
            key-positions = <30 14>;
        };

        ctrl-shift-combo {
            bindings = <&ctrlShiftCombo>;
            key-positions = <24 25>;
        };

        one-keyboard-control {
            bindings = <&to 4>;
            key-positions = <12 0>;
        };

        hightligt_text_combo {
            bindings = <&mo 1>;
            key-positions = <15 14>;
            layers = <0>;
        };
    };

    macros {
        alt_tab: alt_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_press>,
                <&kp ALT_ERASE>,
                <&macro_release>,
                <&kp LEFT_SHIFT>;

            label = "ALT_TAB";
        };

        ctrlShiftCombo: ctrlShiftCombo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&lt 1 LEFT_SHIFT &kp LCTRL &kp LEFT_SHIFT>,
                <&macro_release>,
                <&lt 1 LEFT_SHIFT &kp LCTRL &kp LEFT_SHIFT>;

            label = "CTRLSHIFTCOMBO";
        };

        zmk_macro: zmk_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp Z &kp M &kp K>,
                <&macro_release>,
                <&kp LEFT_SHIFT>;

            label = "ZMK_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
&kp ESC    &kp Q  &kp W        &kp E             &kp R  &kp T                                                         &kp Y      &kp U  &kp I              &kp O    &kp P     &kp BSPC
&kp TAB    &kp A  &mt RCTRL S  &mt LEFT_SHIFT D  &kp F  &kp G                                                         &kp H      &kp J  &mt RIGHT_SHIFT K  &kp L    &kp SEMI  &kp ENTER
&kp LSHFT  &kp Z  &kp X        &kp C             &kp V  &kp B        &alt_tab     &kp LEFT_GUI  &kp ENTER  &kp SPACE  &kp N      &kp M  &kp COMMA          &kp DOT  &kp FSLH  &kp RSHIFT
                                                        &lt 1 MINUS  &lt 2 SPACE  &tog 3        &kp LCTRL  &kp SPACE  &kp EQUAL
            >;
        };

        cursor_layer {
            display-name = "cursor_layer";
            bindings = <
&trans  &trans  &trans     &trans          &trans  &trans                                     &kp HOME  &kp ENTER       &kp UP_ARROW    &kp BACKSPACE    &trans  &trans
&trans  &trans  &kp LCTRL  &kp LEFT_SHIFT  &trans  &trans                                     &kp END   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none   &trans
&trans  &trans  &trans     &trans          &trans  &trans  &trans  &trans  &trans    &trans   &trans    &trans          &trans          &trans           &trans  &trans
                                                   &trans  &trans  &trans  &kp HOME  &kp END  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp DOWN UP_ARROW>,
                <&inc_dec_kp RIGHT LEFT>;
        };

        mouse_control {
            display-name = "mouse_control";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &msc SCRL_DOWN  &mmv MOVE_UP    &msc SCRL_UP     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp RCLK  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &trans  &msc SCRL_LEFT  &trans          &msc SCRL_RIGHT  &trans     &trans
                                        &trans  &trans  &trans  &trans  &mkp LCLK  &trans
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };

        number_row {
            bindings = <
&trans  &kp NUMBER_1  &kp N2  &kp N3  &kp N4  &kp N5                                  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
&trans  &trans        &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                              &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };

        onekeyboardControl {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                        &trans  &trans  &trans  &trans          &mmv MOVE_UP    &msc SCRL_RIGHT
&trans  &trans  &trans  &trans  &trans  &trans                                        &trans  &trans  &trans  &msc SCRL_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp RCTRL  &mkp LCLK  &trans  &trans  &trans  &mmv MOVE_LEFT  &msc SCRL_DOWN  &msc SCRL_UP
                                        &trans  &trans  &trans  &trans     &mkp RCLK  &trans
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };
    };
};
