    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
&kp GRAVE       &num_row NUMBER_1 Q  &num_row NUMBER_2 W  &num_row NUMBER_3 E  &num_row NUMBER_4 R  &num_row N5 T                                                                                                &num_row NUMBER_6 Y  &num_row N7 U  &num_row N8 I  &num_row N9 O  &num_row N0 P  &kp BSPC
&kp TAB         &holdCtrlA 0 A       &holdCtrlS 0 S       &holdCtrlD 0 D       &holdCtrlF 0 F       &kp G                                                                                                        &kp H                &kp J          &kp K          &kp L          &kp SEMICOLON  &kp SQT
&kp LEFT_SHIFT  &holdCtrlZ 0 Z       &holdCtrlX 0 X       &holdCtrlC 0 C       &holdCtrlV 0 V       &holdCtrlB 0 B           &altAndlayer  &winAndlayer  &functionLayerTap 8 BACKSLASH  &symbolLayertap 9 ENTER  &kp N                &kp M          &kp COMMA      &kp DOT        &kp FSLH       &kp RIGHT_SHIFT
                                                                                                    &cursorLayerTap 6 MINUS  &lt 4 SPACE   &kp LCTRL     &kp RCTRL                      &kp SPACE                &lt 10 EQUAL
            >;
        };

        MACLayer {
            display-name = "MacLayer";
            bindings = <
&kp GRAVE       &num_row NUMBER_1 Q   &num_row NUMBER_2 W   &num_row NUMBER_3 E   &num_row NUMBER_4 R   &num_row N5 T                                                                                                    &num_row NUMBER_6 Y  &num_row N7 U  &num_row N8 I  &num_row N9 O  &num_row N0 P  &kp BSPC
&kp TAB         &MACHoldCommandA 0 A  &MACHoldCommandS 0 S  &MACHoldCommandD 0 D  &MACHoldCommandF 0 F  &MACHoldCommandG 0 G                                                                                             &kp H                &kp J          &kp K          &kp L          &kp SEMICOLON  &kp SQT
&kp LEFT_SHIFT  &MACHoldCommandZ 0 Z  &MACHoldCommandX 0 X  &MACHoldCommandC 0 C  &MACHoldCommandV 0 V  &MACHoldCommandB 0 B     &kp LEFT_ALT  &kp LEFT_GUI      &functionLayerTap 8 BACKSLASH  &symbolLayertap 9 ENTER  &kp N                &kp M          &kp COMMA      &kp DOT        &kp FSLH       &kp RIGHT_SHIFT
                                                                                                        &cursorLayerTap 7 MINUS  &lt 4 SPACE   &kp LEFT_CONTROL  &kp RCTRL                      &kp SPACE                &lt 10 EQUAL
            >;
        };

        number_row {
            bindings = <
&trans     &kp NUMBER_1  &kp N2   &kp N3   &kp N4   &kp N5                                                  &kp N6   &kp N7   &kp N8   &kp N9   &kp N0  &numToEsc
&numToTab  &numToA       &numToS  &numToD  &numToF  &numToG                                                 &numToH  &numToJ  &numToK  &numToL  &trans  &numToApostrophe
&trans     &numToZ       &numToX  &numToC  &numToV  &numToB  &trans  &trans       &trans       &numToEnter  &numToN  &numToM  &trans   &trans   &trans  &trans
                                                    &trans   &trans  &numToCtrlL  &numToCtrlR  &trans       &trans
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };

        MACNumberRow {
            bindings = <
&trans     &kp NUMBER_1  &kp N2     &kp N3     &kp N4     &kp N5                                                       &kp N6     &kp N7     &kp N8     &kp N9     &kp N0  &MACnuToEsc
&MACnuTab  &MACnuToA     &MACnuToS  &MACnuToD  &MACnutoF  &MACnumToG                                                   &MACnuToH  &MACnuToJ  &MACnuToK  &MACnuToK  &trans  &trans
&trans     &MACnuToZ     &trans     &MACnuToC  &MACnuToV  &MACnuToB   &trans  &trans       &trans       &MACnuToEnter  &MACnuToN  &MACnuToM  &trans     &trans     &trans  &trans
                                                          &trans      &trans  &numToCtrlL  &numToCtrlR  &trans         &trans
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };

        mouse_control {
