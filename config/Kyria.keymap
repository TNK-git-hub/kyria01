#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 300   // mousescroll SPEED

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <3000>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <1000>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&mt { flavor = "tap-preferred"; };

&lt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&sk {
    quick-release;
    lazy;
};

/ {
    behaviors {
        Scroll_D_U: Scroll_D_U {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_D_U";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        TD01: TD01 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD01";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp PERIOD>;
        };

        Scroll_U_D: Scroll_U_D {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_U_D";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        Scroll_LR: Scroll_LR {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_LR";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };

        Scroll_RL: Scroll_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_RL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;

            tap-ms = <20>;
        };

        mouse_DU: mouse_DU {
            compatible = "zmk,behavior-sensor-rotate";
            label = "MOUSE_DU";
            #sensor-binding-cells = <0>;
            bindings = <&mmv MOVE_DOWN>, <&mmv MOVE_UP>;
        };

        mouse_RL: mouse_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "MOUSE_RL";
            #sensor-binding-cells = <0>;
            bindings = <&mmv MOVE_RIGHT>, <&mmv MOVE_LEFT>;
        };

        cursorandmouse: cursorandmouse_ {
            compatible = "zmk,behavior-tap-dance";
            label = "CURSORANDMOUSE ";
            #binding-cells = <0>;
            bindings = <&lt 5 SPACE>, <&lt 1 SPACE>;

            tapping-term-ms = <400>;
        };

        num_row: num_row {
            compatible = "zmk,behavior-hold-tap";
            label = "NUM_ROW";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
        };

        holdCtrlZ: holdCtrlZ {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDCTRLZ";
            bindings = <&ctrlZ>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
        };

        holdCtrlX: holdCtrlX {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDCTRLX";
            bindings = <&ctrlX>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
        };

        holdCtrlC: holdCtrlC {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDCTRLC";
            bindings = <&ctrlC>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
        };

        holdCtrlA: holdCtrlA {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDCTRLA";
            bindings = <&ctrlA>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
        };

        shiftCtrlTapDance: shiftCtrlTapDance {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFTCTRLTAPDANCE";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp LCTRL>;
        };

        shiftEnterTapDance: shiftEnterTapDance {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFTENTERTAPDANCE";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_SHIFT>, <&kp ENTER>;
        };

        cursorLayerTap: cursorLayerTap {
            compatible = "zmk,behavior-hold-tap";
            label = "CURSORLAYERTAP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <32 43 44 33 45 7 8 9 10 11 19 20 21 22 23 35 36 37 38 39 45 6 7 18 19 34 35>;
        };

        WinKey: WinKey {
            compatible = "zmk,behavior-tap-dance";
            label = "WINKEY";
            #binding-cells = <0>;
            bindings = <&win_layer>, <&winTabCom>;

            tapping-term-ms = <300>;
        };

        LBracketTapDance: LBracketTapDance {
            compatible = "zmk,behavior-tap-dance";
            label = "LBRACKETTAPDANCE";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET>, <&kp LEFT_BRACE>;

            tapping-term-ms = <600>;
        };

        RBracketTapDance: RBracketTapDance {
            compatible = "zmk,behavior-tap-dance";
            label = "RBRACKETTAPDANCE";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACE>;

            tapping-term-ms = <600>;
        };

        F10WinB: F10WinB {
            compatible = "zmk,behavior-hold-tap";
            label = "F10WINB";
            bindings = <&winB>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        holdCtrlS: holdCtrlS {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDCTRLS";
            bindings = <&ctrlA>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
        };

        holdCtrlV: holdCtrlV {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDCTRLV";
            bindings = <&ctrlV>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
        };

        symbolLayertap: symbolLayertap {
            compatible = "zmk,behavior-hold-tap";
            label = "SYMBOLLAYERTAP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-trigger-key-positions = <1 2 3 4 5 16 15 19 18 6 7 8 20 9 21>;
        };
    };

    combos {
        compatible = "zmk,combos";

        ctrl-shift-combo {
            bindings = <&ctrlShiftCombo>;
            key-positions = <24 25>;
            layers = <0 1 7>;
        };

        one-keyboard-control {
            bindings = <&to 5>;
            key-positions = <12 0>;
        };

        back_comma {
            bindings = <&kp GRAVE>;
            key-positions = <1 2>;
            layers = <1 7>;
        };

        bt_cl_all {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <33 34>;
        };

        bt_next {
            bindings = <&bt BT_NXT>;
            key-positions = <43 33>;
            timeout-ms = <300>;
        };

        number_row_combo {
            bindings = <&tog 1>;
            key-positions = <16 19>;
            layers = <0 1>;
        };

        toggle_mouse {
            bindings = <&tog 2>;
            key-positions = <16 41>;
            layers = <0 2>;
        };

        esc {
            bindings = <&numToEsc>;
            key-positions = <41 15>;
            timeout-ms = <400>;
            layers = <0 1 2>;
            slow-release;
        };

        combo_left_shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <15 16>;
            timeout-ms = <200>;
            layers = <0 7 1 13 12>;
            slow-release;
        };

        combo_right_shift {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <19 20>;
            timeout-ms = <200>;
            layers = <0 7 1 13 12>;
            slow-release;
        };

        capslook {
            bindings = <&kp CAPSLOCK>;
            key-positions = <15 20>;
            layers = <0 1>;
        };

        delete_word_combo {
            bindings = <&delete_word>;
            key-positions = <21 22>;
            layers = <3>;
        };

        firstP_gaming {
            bindings = <&tog 10>;
            key-positions = <12 24>;
            layers = <0 1 7 10>;
        };

        togKbMouse {
            bindings = <&tog 11>;
            key-positions = <42 31>;
            layers = <0 1 11>;
        };

        alt_tab_combo {
            bindings = <&alt_tab>;
            key-positions = <30 3>;
            layers = <0 1 3>;
        };

        altF4Combo {
            bindings = <&altF4d>;
            key-positions = <4 30>;
            layers = <0 1>;
        };

        winBCombo {
            bindings = <&winB>;
            key-positions = <31 29>;
            layers = <0 1>;
        };

        winTabCombo {
            bindings = <&winTabCom>;
            key-positions = <31 3>;
            layers = <0 12>;
        };

        CursorCtrlCombo {
            bindings = <&CursorHoldControl>;
            key-positions = <14 40>;
            layers = <0 1>;
        };

        CursorHoldShiftCombo {
            bindings = <&CursorHoldShift>;
            key-positions = <15 40>;
            layers = <0 1>;
        };

        CursorHoldCtrlShift {
            bindings = <&CursorHoldCtrlShift>;
            key-positions = <15 14 40>;
            layers = <0 1>;
        };
    };

    macros {
        alt_tab: alt_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "ALT_TAB";
        };

        ctrlShiftCombo: ctrlShiftCombo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LEFT_SHIFT>,
                <&macro_release>,
                <&kp LCTRL &kp LEFT_SHIFT>;

            label = "CTRLSHIFTCOMBO";
        };

        ctrl_a: ctrl_a {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp A>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "CTRL_A";
        };

        delete_word: delete_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp LEFT_ARROW &kp BACKSPACE>,
                <&macro_release>,
                <&kp LCTRL &kp LEFT_SHIFT>;

            label = "DELETE_WORD";
        };

        hi_prv: hi_prv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp LEFT_ARROW>,
                <&macro_release>,
                <&kp LCTRL &kp LEFT_SHIFT>;

            label = "HI_PRV";
        };

        shift_f10: shift_f10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp F10>,
                <&macro_release>,
                <&kp LEFT_SHIFT>;

            label = "SHIFT_F10";
        };

        ctrlX: ctrlX {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp X>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "CTRLX";
        };

        ctrlC: ctrlC {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp C>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "CTRLC";
        };

        ctrlV: ctrlV {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp V>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "CTRLV";
        };

        win_layer: win_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mo 12 &kp LEFT_GUI>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 12 &kp LEFT_GUI>;

            label = "WIN_LAYER";
        };

        alt_layer: alt_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mo 13 &kp LEFT_ALT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 13 &kp LEFT_ALT>;

            label = "ALT_LAYER";
        };

        ctrlZ: ctrlZ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp Z>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "CTRLZ";
        };

        ctrlY: ctrlY {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp Y>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "CTRLY";
        };

        altF4d: altF4d {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp F4>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "ALTF4D";
        };

        winB: winB {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI>,
                <&macro_tap>,
                <&kp B>,
                <&macro_release>,
                <&kp LEFT_GUI>;

            label = "WINB";
        };

        RCtrlToDefault: ctrlToDefault {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&to 0>,
                <&macro_press>,
                <&kp RCTRL>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp RCTRL>;

            label = "CTRLTODEFAULT";
        };

        LCtrlToDefault: LCtrlToDefault {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&to 0>,
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "LCTRLTODEFAULT";
        };

        winTabCom: winTabCom {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LEFT_GUI>;

            label = "WINTABCOM";
        };

        CursorHoldControl: CursorHoldControl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &mo 3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LCTRL &mo 3>;

            label = "CURSORHOLDCONTROL";
        };

        CursorHoldShift: CursorHoldShift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT &mo 3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mo 3>;

            label = "CURSORHOLDSHIFT";
        };

        CursorHoldCtrlShift: CursorHoldCtrlShift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LEFT_SHIFT &mo 3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LCTRL &kp LEFT_SHIFT &mo 3>;

            label = "CURSORHOLDCTRLSHIFT";
        };

        ctrlA: ctrlA {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp A>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "CTRLA";
        };

        ctrlS: ctrlS {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp S>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "CTRLS";
        };

        numToSemicolon: numToDefaultKey {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&to 0>,
                <&macro_press>,
                <&kp SEMI>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp SEMI>;

            label = "NUMTODEFAULTKEY";
        };

        numToSlash: numToDivide {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&to 0>,
                <&macro_press>,
                <&kp SLASH>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp SLASH>;

            label = "NUMTODIVIDE";
        };

        numToL: numToL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&to 0>,
                <&macro_press>,
                <&kp L>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp L>;

            label = "NUMTOL";
        };

        numToDot: numToGreater {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&to 0>,
                <&macro_press>,
                <&kp DOT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp DOT>;

            label = "NUMTOGREATER";
        };

        numToComma: numToColon {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&to 0>,
                <&macro_press>,
                <&kp COMMA>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp COMMA>;

            label = "NUMTOCOLON";
        };

        numToK: numToK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&to 0>,
                <&macro_press>,
                <&kp K>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp K>;

            label = "NUMTOK";
        };

        numToJ: numToJ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&to 0>,
                <&macro_press>,
                <&kp J>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp J>;

            label = "NUMTOJ";
        };

        numToM: numToM {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&to 0>,
                <&macro_press>,
                <&kp M>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp M>;

            label = "NUMTOM";
        };

        numToH: numToH {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&to 0>,
                <&macro_press>,
                <&kp H>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp H>;

            label = "NUMTOH";
        };

        numToN: numToN {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&to 0>,
                <&macro_press>,
                <&kp N>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp N>;

            label = "NUMTON";
        };

        numToEsc: numToEsc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&to 0>,
                <&macro_press>,
                <&kp ESCAPE>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp ESCAPE>;

            label = "NUMTOESC";
        };

        numToA: numToA {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&to 0>,
                <&macro_press>,
                <&kp A>,
