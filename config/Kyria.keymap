        numToZ: numToZ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&to 0>,
                <&macro_press>,
                <&kp Z>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp Z>;

            label = "NUMTOZ";
        };

        numToS: numToS {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&to 0>,
                <&macro_press>,
                <&kp S>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp S>;

            label = "NUMTOS";
        };

        numToX: numToX {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&to 0>,
                <&macro_press>,
                <&kp X>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp X>;

            label = "NUMTOX";
        };

        numToD: numToD {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&to 0>,
                <&macro_press>,
                <&kp D>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp D>;

            label = "NUMTOD";
        };

        numToC: numToC {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&to 0>,
                <&macro_press>,
                <&kp C>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp C>;

            label = "NUMTOC";
        };

        numToF: numToF {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&to 0>,
                <&macro_press>,
                <&kp F>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp F>;

            label = "NUMTOF";
        };

        numToG: numToG {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&to 0>,
                <&macro_press>,
                <&kp G>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp G>;

            label = "NUMTOG";
        };

        numToB: numToB {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&to 0>,
                <&macro_press>,
                <&kp B>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp B>;

            label = "NUMTOB";
        };

        numToV: numToV {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&to 0>,
                <&macro_press>,
                <&kp V>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp V>;

            label = "NUMTOV";
        };

        numToApostrophe: numToApostrophe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&to 0>,
                <&macro_press>,
                <&kp SQT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp SQT>;

            label = "NUMTOAPOSTROPHE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
&kp GRAVE       &num_row NUMBER_1 Q  &num_row NUMBER_2 W  &num_row NUMBER_3 E  &num_row NUMBER_4 R  &num_row N5 T                                                                               &num_row NUMBER_6 Y  &num_row N7 U  &num_row N8 I  &num_row N9 O  &num_row N0 P  &kp BSPC
&kp TAB         &kp A                &kp S                &kp D                &kp F                &kp G                                                                                       &kp H                &kp J          &kp K          &kp L          &kp SEMICOLON  &kp SQT
&kp LEFT_SHIFT  &holdCtrlZ 0 Z       &holdCtrlX 0 X       &holdCtrlC 0 C       &holdCtrlV 0 V       &kp B                    &alt_layer   &win_layer  &lt 6 BACKSLASH  &symbolLayertap 7 ENTER  &kp N                &kp M          &kp COMMA      &kp DOT        &kp FSLH       &kp RIGHT_SHIFT
                                                                                                    &cursorLayerTap 3 MINUS  &lt 2 SPACE  &kp LCTRL   &kp RCTRL        &kp SPACE                &lt 9 EQUAL
            >;
        };

        number_row {
            bindings = <
&trans  &kp NUMBER_1  &kp N2   &kp N3   &kp N4   &kp N5                                   &kp N6   &kp N7   &kp N8   &kp N9   &kp N0           &numToEsc
&trans  &numToA       &numToS  &numToD  &numToF  &numToG                                  &numToH  &numToJ  &numToK  &numToL  &numToSemicolon  &numToApostrophe
&trans  &numToZ       &numToX  &numToC  &numToV  &numToB  &trans  &trans  &trans  &trans  &numToN  &numToM  &trans   &trans   &trans           &trans
                                                 &trans   &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };

        mouse_control {
            display-name = "mouse_control";
            bindings = <
&trans  &trans  &trans       &trans     &trans   &trans                                     &trans  &msc SCRL_DOWN  &mmv MOVE_UP    &msc SCRL_UP     &trans     &trans
&trans  &trans  &kp LS(TAB)  &kp LCTRL  &kp TAB  &trans                                     &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp RCLK  &trans
&trans  &trans  &trans       &trans     &trans   &trans  &trans  &trans  &trans  &trans     &trans  &msc SCRL_LEFT  &mkp MCLK       &msc SCRL_RIGHT  &trans     &trans
                                                 &trans  &trans  &trans  &trans  &mkp LCLK  &trans
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };

        cursor_layer {
            display-name = "cursor_layer";
            bindings = <
&trans  &trans  &trans     &trans          &trans   &trans                                         &kp HOME    &kp ENTER        &kp UP_ARROW    &kp BACKSPACE    &ctrl_a  &trans
&trans  &trans  &kp LCTRL  &kp LEFT_SHIFT  &kp TAB  &trans                                         &kp END     &kp LEFT_ARROW   &kp DOWN_ARROW  &kp RIGHT_ARROW  &hi_prv  &trans
&trans  &trans  &trans     &trans          &trans   &trans  &trans  &trans  &kp DELETE  &kp ENTER  &trans      &kp RIGHT_SHIFT  &trans          &trans           &trans   &trans
                                                    &trans  &trans  &trans  &trans      &kp SPACE  &shift_f10
            >;

            sensor-bindings =
                <&inc_dec_kp DOWN UP_ARROW>,
                <&inc_dec_kp RIGHT LEFT>;
        };

        onekeyboardControl {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                        &trans  &trans  &trans  &trans          &mmv MOVE_UP    &msc SCRL_RIGHT
&trans  &trans  &trans  &trans  &trans  &trans                                        &trans  &trans  &trans  &msc SCRL_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp RCTRL  &mkp LCLK  &trans  &trans  &trans  &mmv MOVE_LEFT  &msc SCRL_DOWN  &msc SCRL_UP
                                        &trans  &trans  &trans  &trans     &mkp RCLK  &trans
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };

        general_gaming_layer {
            bindings = <
&trans  &kp TAB    &kp Q  &kp W  &kp E  &kp R                                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LSHFT  &kp A  &kp S  &kp D  &kp F                                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &kp Z  &kp X  &kp C  &kp V   &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans  &kp SPACE  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };

        function_layer {
            bindings = <
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &kp F5                                          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F6  &kp F7   &kp F8   &kp F9   &F10WinB 0 F10                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp F13  &kp F11  &kp F12  &winB           &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                           &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        symbol {
            bindings = <
&trans  &kp EXCL  &kp AT  &kp HASH   &kp DOLLAR     &kp PERCENT                                  &kp PLUS   &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans  &trans
&trans  &trans    &trans  &kp CARET  &kp AMPERSAND  &trans                                       &kp MINUS  &kp SLASH     &LBracketTapDance     &RBracketTapDance      &trans  &trans
&trans  &trans    &trans  &trans     &trans         &trans       &trans  &trans  &trans  &trans  &trans     &trans        &trans                &trans                 &trans  &trans
                                                    &trans       &trans  &trans  &trans  &trans  &trans
            >;
        };

        blank_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        setting_layer {
            bindings = <
&trans  &trans             &trans           &trans         &kp PRINTSCREEN  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_BRI_DEC  &kp C_BRI_INC    &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp C_MUTE         &trans           &trans         &trans           &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                                            &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        gaming1st_person {
            bindings = <
&trans  &kp TAB    &kp Q  &kp W  &kp E  &kp R                                         &trans  &msc SCRL_DOWN  &mmv MOVE_UP    &msc SCRL_UP     &trans     &trans
&trans  &kp LSHFT  &kp A  &kp S  &kp D  &kp F                                         &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp RCLK  &trans
&trans  &trans     &kp Z  &kp X  &kp C  &kp V   &trans     &trans  &trans  &trans     &trans  &trans          &trans          &trans           &trans     &trans
                                        &trans  &kp SPACE  &trans  &trans  &mkp LCLK  &trans
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };

        kbMouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &ctrlZ  &ctrlX  &ctrlC  &ctrlV  &ctrlY                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        window_navi {
            bindings = <
&trans  &trans  &trans  &kp TAB  &trans  &trans                                  &trans  &trans          &kp UP_ARROW    &trans           &trans  &trans
&trans  &trans  &trans  &trans   &trans  &winB                                   &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans
&trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans          &trans           &trans  &trans
                                         &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        alt_navi {
            bindings = <
&trans  &trans  &trans  &kp TAB  &kp F4  &trans                                  &trans  &trans          &kp UP_ARROW    &trans           &trans  &trans
&trans  &trans  &trans  &trans   &trans  &trans                                  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans
&trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans          &trans           &trans  &trans
                                         &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        OxygenNotIncludedLayer {
            bindings = <
&trans  &kp TAB    &kp Q  &kp W  &kp E  &kp R                                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LSHFT  &kp A  &kp S  &kp D  &kp F                                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &kp Z  &kp X  &kp C  &kp V   &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans  &kp SPACE  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };
    };
};
